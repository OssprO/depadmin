{
  "name": "@depadmin/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:int": "vitest run --config vitest.config.int.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@depadmin/shared": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
