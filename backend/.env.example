# Copy to backend/.env for local development.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_VERSION=dev

# Matches infra/docker-compose.dev.yml.
DATABASE_URL=postgresql://depadmin:depadmin@localhost:5433/depadmin

# Signs access tokens (at least 32 characters). Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-chars

# Only read by the seed (pnpm db:seed), which creates the superadmin if there is none.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=
