{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    // Read by the shadcn CLI to resolve "@/..." aliases from components.json.
    // Without it, shadcn writes components to a literal "@/" directory.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
