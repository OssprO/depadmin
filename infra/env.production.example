# /opt/depadmin/.env on the VPS (chmod 600). Never commit the real one.

# Generate each with: openssl rand -hex 32   (hex: safe inside the database URL)
POSTGRES_PASSWORD=
JWT_SECRET=

# The images to run: the Deploy workflow sets the tag (the version, e.g. 1.0.3) on every deploy.
DEPADMIN_IMAGE=ghcr.io/osspro/depadmin
DEPADMIN_TAG=latest

# Port on 127.0.0.1 that the VPS's nginx proxies to (pick a free one).
WEB_PORT=8063

# Backups (docs/DESPLIEGUE.md §9, ADR-0030). restic encrypts them with this password, which
# must also live in your password manager: without it, no backup can be restored.
# Generate it with: openssl rand -base64 32
RESTIC_PASSWORD=
# The copy off the VPS, in Backblaze B2, through its S3-compatible API.
RESTIC_REMOTE_REPOSITORY=s3:s3.us-west-004.backblazeb2.com/YOUR_BUCKET/depadmin
B2_KEY_ID=
B2_APPLICATION_KEY=

# healthchecks.io ping URL (https://hc-ping.com/<ping key>): the jobs and the backups report
# there, and it emails you when one fails or doesn't arrive. Empty reports nothing.
HEALTHCHECKS_PING_URL=
