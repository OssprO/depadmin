# /opt/depadmin/.env on the VPS (chmod 600). Never commit the real one.

# Generate each with: openssl rand -hex 32   (hex: safe inside the database URL)
POSTGRES_PASSWORD=
JWT_SECRET=

# The images to run: the Deploy workflow sets the tag (the version, e.g. 1.0.3) on every deploy.
DEPADMIN_IMAGE=ghcr.io/osspro/depadmin
DEPADMIN_TAG=latest

# Port on 127.0.0.1 that the VPS's nginx proxies to (pick a free one).
WEB_PORT=8063
